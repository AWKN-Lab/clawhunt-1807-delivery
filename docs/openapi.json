        "title": "AdminLoginIn"
      },
      "BookingIn": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "slot_start": {
            "type": "string",
            "title": "Slot Start"
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "slot_start"
        ],
        "title": "BookingIn"
      },
      "CandidatePatch": {
        "properties": {
          "area_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area Text"
          },
          "job_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Type"
          },
          "start_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Text"
          },
          "experience_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Experience Text"
          },
          "has_ebike": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Has Ebike"
          },
          "health_cert": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Health Cert"
          }
        },
        "type": "object",
        "title": "CandidatePatch"
      },
      "ConsentIn": {
        "properties": {
          "consent_version": {
            "type": "string",
            "title": "Consent Version"
          },
          "consent_at": {
            "type": "string",
            "title": "Consent At"
          },
          "source_channel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Channel"
          }
        },
        "type": "object",
        "required": [
          "consent_version",
          "consent_at"
        ],
        "title": "ConsentIn"
      },
      "DetokenizeIn": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "token",
          "reason"
        ],
        "title": "DetokenizeIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandoffIn": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "HandoffIn"
      },
      "MessageIn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
